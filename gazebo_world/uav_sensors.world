<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="tinyfl_uav_sensors_world">

    <!-- Sun Light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- UAV Model (Spawns 1 UAV by default) -->
    <include>
      <name>uav1</name>
      <uri>model://quadrotor</uri>
      <pose>0 0 1 0 0 0</pose>
    </include>

    <!-- Example Sensor Block (Camera Sensor) -->
    <model name="sensor_block">
      <static>true</static>
      <pose>2 2 1 0 0 0</pose>

      <link name="camera_link">
        <sensor name="camera_sensor" type="camera">
          <camera>
            <horizontal_fov>1.396</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
        </sensor>
      </link>
    </model>

    <!-- Environment Models -->
    <include>
      <uri>model://tree</uri>
      <pose>5 3 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://building</uri>
      <pose>-3 4 0 0 0 0</pose>
    </include>

    <!-- Physics Configuration -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

  </world>
</sdf>
    